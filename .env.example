# Copier ce fichier en .env et remplir les valeurs
# cp .env.example .env

# Clé secrète Django (générer une nouvelle pour la prod : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=votre-cle-secrete-ici

# True en développement, False en production
DEBUG=True

# --- Production (Render) uniquement ---
# DATABASE_URL : ajoutée automatiquement par Render quand la base PostgreSQL est liée au service
# MEDIA_ROOT : chemin du Persistent Disk (ex: /data/media)
# MEDIA_ROOT=/data/media

# --- Stockage des médias sur Cloudflare R2 (production uniquement) ---
# En local, laisser ces lignes commentées : les médias restent dans le dossier media/.
# MEDIA_STORAGE=r2 active R2. Ne le définir sur Render qu'après la copie des fichiers
# (voir la procédure de bascule dans DEPLOY_RENDER.md).
# MEDIA_STORAGE=r2
# AWS_ACCESS_KEY_ID=identifiant-du-jeton-r2
# AWS_SECRET_ACCESS_KEY=secret-du-jeton-r2
# AWS_STORAGE_BUCKET_NAME=wmbtab-media
# Sans le nom du bucket à la fin (le tableau de bord Cloudflare l'ajoute) :
# AWS_S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=media.wmbranhamtabernacle.org
